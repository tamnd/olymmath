// The site at https://olymmath.tamnd.com is a Worker with static assets only. `om site build` writes the files to build/site.
{
  "name": "olymmath",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "olymmath.tamnd.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
